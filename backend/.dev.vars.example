# Sender allowlist gate (default: on).
# Only mail from known bank/fintech senders has its body fetched and
# normalized; everything else is persisted metadata-only as IGNORED.
# Set to "off" to disable (not recommended).
# EMAIL_SENDER_GATE=on

# Extra allowlist entries, comma-separated. Entry kinds by shape:
#   with '@'  -> exact address match        (alerts@mybank.com)
#   with '.'  -> domain/subdomain match     (mybank.co.in)
#   otherwise -> brand token, substring of the whole From header (mybank)
# EMAIL_SENDER_ALLOWLIST_EXTRA=mybank,otherbank.co.in,alerts@thirdbank.com

# First sync of a connection fetches at most this many days of history (default 90).
# EMAIL_SYNC_INITIAL_LOOKBACK_DAYS=90

# Merchant mapping is fail-closed and defaults to off. Only 1/on/true/yes
# enable the daily mapper. Keep this off until the mapping pipeline is refined.
# MERCHANT_MAPPING_ENABLED=false

# AI provider (default: opencode). "openrouter" switches the whole stack —
# chat URL, API key var, and model defaults (free-tier ":free" models).
# Configure both keys and flip this one var to switch providers.
# AI_PROVIDER=openrouter
# OPENCODE_GO_API_KEY=...
# OPENROUTER_API_KEY=...
# Optional management key: enables purchased/remaining credit balance in Settings.
# OPENROUTER_MANAGEMENT_API_KEY=...
# Daily-jobs model per provider (sender classifier + merchant mapper):
# OPENCODE_GO_MODEL=deepseek-v4-flash
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Only this authenticated app user can open the AI usage dashboard. No longer
# a committed var (Task 7): set it here for local dev and with
# `wrangler secret put AI_USAGE_ADMIN_USER_ID` for the deployed Worker.
# AI_USAGE_ADMIN_USER_ID=a661a921-cdb0-503b-a810-4b25e4f15ca0

# Per-tier attempt schedule before rotating to the next model tier
# (default 2,2,1 -> max 5 attempts total across the 3-tier chain).
# AI_NORMALIZER_TIER_ATTEMPTS=2,2,1

# Pipeline trace logging (default off). One structured log line per
# transaction with the full resolve outcome. Content-bearing (counterparty
# names) — local dev only. Refused outright when NODE_ENV=production, flag
# or no flag.
# EMAIL_PIPELINE_TRACE=true

# Secret guarding the /internal/* ops endpoints (requeue, metadata backfill,
# sync probe). Required to invoke them.
# AI_REQUIRES_WEBHOOK_SECRET=local-dev-secret

# AI normalizer masks all numbers as <N#> placeholders before the model call
# (default true). Set to false only for debugging extraction quality.
# AI_NORMALIZER_MASK_NUMBERS=true

# Emails per model call in masked mode (default 4, max 10, 1 disables
# batching). Unmasked mode always processes one email per call.
# AI_NORMALIZER_BATCH_SIZE=4

# Cross-email duplicate window in minutes (default 10; 0 disables). A second
# alert for the same user+amount+direction inside the window is never
# auto-verified.
# TXN_DEDUP_WINDOW_MINUTES=10

# Clerk Backend API secret (sk_test_… / sk_live_…). Lets DELETE /account remove
# the Clerk user. Absent: the account data is still deleted and the nightly
# purge job retries the Clerk deletion once the key is set.
# CLERK_SECRET_KEY=sk_test_...

# Days a processed / ignored / unrecognized email keeps its stored body before
# the nightly purge job blanks it (default 90). The job itself is switched on
# in the admin dashboard (job_schedules); failed emails always keep their body.
# RAW_EMAIL_BODY_RETENTION_DAYS=90

# Tavily web search for the daily merchant mapper (free tier: 1000/month).
# Comma-separate multiple keys to rotate when one exhausts its quota.
# Absent = mapper runs without web context, exactly as before.
# TAVILY_API_KEY=tvly-aaa,tvly-bbb,tvly-ccc

# Per-user fair use, reset at midnight Asia/Kolkata. The email cap applies
# independently to listed message IDs and fetched bodies; AI includes retries.
# Per-user overrides are editable in Settings -> AI operations -> Per-user fair use.
# USER_DAILY_EMAIL_FETCH_CAP=500
# USER_DAILY_AI_CALL_CAP=200
# Nightly jobs take min(cap, backlog), in model batches of at most 40.
# MAX_MERCHANTS_PER_RUN=200
# MAX_SENDERS_PER_RUN=200

# Frontend origins allowed to mint Clerk tokens for this backend, checked
# against the token's `azp` claim (comma-separated). Clerk's default session
# tokens carry no `aud`, so this is the cross-app protection. Unset = not
# enforced, which is today's behaviour. Set it BEFORE the deploy that
# enforces it, or every request 401s.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://app.example.com

# Rate limiting needs no vars: the USER_RATE_LIMITER / IP_RATE_LIMITER
# bindings live in wrangler.jsonc (300/min per user, 60/min per IP). They do
# not exist under plain `vitest`, and the limiter fails open without them.

# Error reporting webhook (default: off). Any endpoint that accepts a POST —
# ntfy, Discord, Slack, a Worker of your own. https only, except http on
# localhost for local dev. Sends event code, truncated message and a flat
# context of identifiers; never email content. A postgres error message can
# quote a constraint or value, so keep the endpoint private.
# ERROR_REPORTING_WEBHOOK_URL=https://alerts.example.com/hook
# Optional bearer token for that endpoint.
# ERROR_REPORTING_WEBHOOK_TOKEN=...
# Per-isolate send budget (default 10/min) and delivery timeout (default 3000ms).
# ERROR_REPORTING_MAX_PER_MINUTE=10
# ERROR_REPORTING_TIMEOUT_MS=3000

# Task 8 needs no other vars: NIGHTLY_QUEUE (nightly job queue) and
# HYPERDRIVE (pooled edge connection, still commented out) are bindings in
# wrangler.jsonc. Both are optional in code — without NIGHTLY_QUEUE the
# nightly jobs use the sync queue, and without HYPERDRIVE the Worker
# connects straight to SUPABASE_POOLER_URL.
