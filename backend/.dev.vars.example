# Sender allowlist gate (default: on).
# Only mail from known bank/fintech senders has its body fetched and
# normalized; everything else is persisted metadata-only as IGNORED.
# Set to "off" to disable (not recommended).
# EMAIL_SENDER_GATE=on

# Extra allowlist entries, comma-separated. Entry kinds by shape:
#   with '@'  -> exact address match        (alerts@mybank.com)
#   with '.'  -> domain/subdomain match     (mybank.co.in)
#   otherwise -> brand token, substring of the whole From header (mybank)
# EMAIL_SENDER_ALLOWLIST_EXTRA=mybank,otherbank.co.in,alerts@thirdbank.com

# First sync of a connection fetches at most this many days of history (default 90).
# EMAIL_SYNC_INITIAL_LOOKBACK_DAYS=90

# AI provider (default: opencode). "openrouter" switches the whole stack —
# chat URL, API key var, and model defaults (free-tier ":free" models).
# Configure both keys and flip this one var to switch providers.
# AI_PROVIDER=opencode
# OPENCODE_GO_API_KEY=...
# OPENROUTER_API_KEY=...
# Daily-jobs model per provider (sender classifier + merchant mapper):
# OPENCODE_GO_MODEL=deepseek-v4-flash
# OPENROUTER_MODEL=nvidia/llama-3.1-nemotron-70b-instruct:free

# Per-tier attempt schedule before rotating to the next model tier
# (default 2,2,1 -> max 5 attempts total across the 3-tier chain).
# AI_NORMALIZER_TIER_ATTEMPTS=2,2,1

# Pipeline trace logging (default off). One structured log line per
# transaction with the full resolve outcome. Content-bearing (counterparty
# names) — local dev only, never enable in production.
# EMAIL_PIPELINE_TRACE=true

# Secret guarding the /internal/* ops endpoints (requeue, metadata backfill,
# sync probe). Required to invoke them.
# AI_REQUIRES_WEBHOOK_SECRET=local-dev-secret

# AI normalizer masks all numbers as <N#> placeholders before the model call
# (default true). Set to false only for debugging extraction quality.
# AI_NORMALIZER_MASK_NUMBERS=true

# Emails per model call in masked mode (default 4, max 10, 1 disables
# batching). Unmasked mode always processes one email per call.
# AI_NORMALIZER_BATCH_SIZE=4

# Cross-email duplicate window in minutes (default 10; 0 disables). A second
# alert for the same user+amount+direction inside the window is never
# auto-verified.
# TXN_DEDUP_WINDOW_MINUTES=10

# Tavily web search for the daily merchant mapper (free tier: 1000/month).
# Comma-separate multiple keys to rotate when one exhausts its quota.
# Absent = mapper runs without web context, exactly as before.
# TAVILY_API_KEY=tvly-aaa,tvly-bbb,tvly-ccc
