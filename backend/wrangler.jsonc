/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-01",
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "../frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api",
			"/api/*"
		]
	},
	"triggers": {
		"crons": [
			"*/10 * * * *",
			"30 21 * * *"
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "EMAIL_SYNC_QUEUE",
				"queue": "money-manager-email-sync"
			}
		],
		"consumers": [
			{
				"queue": "money-manager-email-sync",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"dead_letter_queue": "money-manager-email-sync-dlq"
			}
		]
	}
}
