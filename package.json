{
  "name": "money-manager",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "npm run dev:frontend & npm run dev:backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "deploy:cloudflare": "npm run build:frontend && npm run deploy --workspace=backend",
    "logos:validate": "node scripts/sync-current-merchant-logos.mjs --validate-only",
    "logos:expand-next-100": "node scripts/expand-merchant-logo-catalog.mjs",
    "logos:validate-next-100": "node scripts/expand-merchant-logo-catalog.mjs --validate-only",
    "logos:upload-next-100": "node --env-file=backend/.dev.vars scripts/upload-merchant-logos.mjs --batch india-next-100-2026-08",
    "logos:expand-next-100-batch-2": "node scripts/expand-merchant-logo-catalog.mjs --batch-2",
    "logos:validate-next-100-batch-2": "node scripts/expand-merchant-logo-catalog.mjs --batch-2 --validate-only",
    "logos:upload-next-100-batch-2": "node --env-file=backend/.dev.vars scripts/upload-merchant-logos.mjs --batch india-next-100-2026-08-batch-2",
    "logos:expand-next-100-batch-3": "node scripts/expand-merchant-logo-catalog.mjs --batch-3",
    "logos:validate-next-100-batch-3": "node scripts/expand-merchant-logo-catalog.mjs --batch-3 --validate-only",
    "logos:upload-next-100-batch-3": "node --env-file=backend/.dev.vars scripts/upload-merchant-logos.mjs --batch india-next-100-2026-08-batch-3",
    "logos:expand-next-100-batch-4": "node scripts/expand-merchant-logo-catalog.mjs --batch-4",
    "logos:validate-next-100-batch-4": "node scripts/expand-merchant-logo-catalog.mjs --batch-4 --validate-only",
    "logos:upload-next-100-batch-4": "node --env-file=backend/.dev.vars scripts/upload-merchant-logos.mjs --batch india-next-100-2026-08-batch-4",
    "logos:resolve-live-unmapped": "node scripts/resolve-live-unmapped-merchant-logos.mjs",
    "logos:validate-live-unmapped": "node scripts/resolve-live-unmapped-merchant-logos.mjs --validate-only",
    "logos:upload-live-unmapped": "node --env-file=backend/.dev.vars scripts/upload-merchant-logos.mjs --batch live-unmapped-merchant-logos-2026-08",
    "logos:list-unmapped": "node --env-file=backend/.dev.vars scripts/scan-unmapped-merchant-logos.mjs",
    "logos:scan-unmapped": "node --env-file=backend/.dev.vars scripts/scan-unmapped-merchant-logos.mjs --record-attempts",
    "logos:sync-current": "node --env-file=backend/.dev.vars scripts/sync-current-merchant-logos.mjs --upload",
    "test": "npm run test --workspace=frontend",
    "test:backend": "npm run test --workspace=backend",
    "test:all": "npm run test && npm run test:backend",
    "lint": "npm run lint --workspace=frontend"
  }
}
